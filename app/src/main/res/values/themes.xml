<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SahyadriSamrakshane" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/forest_dark</item>
    </style>

    <style name="Theme.SahyadriSamrakshane.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forest_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_leaf</item>
        <item name="postSplashScreenTheme">@style/Theme.SahyadriSamrakshane</item>
    </style>

    <color name="forest_dark">#0D1B0D</color>
</resources>
